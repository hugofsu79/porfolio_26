---
import "../styles/global.css";
import ContactMe from "../components/layout/Contact.astro";
import { Code } from "astro:components";
const { title = "Hugofolio" } = Astro.props;
const { isHome = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class={isHome ? "is-home" : "is-page"}>
    <ContactMe />
    <slot />
    <footer></footer>

    <script type="module" src="/src/scripts/contactPanel.js"></script>
    <script type="module" src="/src/scripts/navbarScroll.js"></script>
    <script type="module" src="/src/scripts/carouselEffect.js"></script>
    <script type="module">
      import "../scripts/marqueeOverflow.js";
    </script>
    <script>
      import { initLoopingRow } from "../scripts/marquee.js";

      // debug: tu dois voir ça dans la console
      console.log("HOME SCRIPT OK", {
        marquee: document.querySelector(".marquee"),
        allies: document.querySelector(".allies"),
      });

      initLoopingRow(".marquee", { speed: 0.6, slowSpeed: 0.05 });

      // on attend le prochain frame pour être 100% safe
      requestAnimationFrame(() => {
        initLoopingRow(".allies", { speed: 0.6, slowSpeed: 0.05 });
      });
    </script>
  </body>
</html>
