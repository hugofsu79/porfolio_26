---
import BootIntro from "../components/BootIntro.astro";
import "../styles/global.css";
import NavbarHome from "../components/layout/Navigation.astro";
import ContactMe from "../components/layout/Contact.astro";
import { Code } from "astro:components";
const { title = "Hugofolio" } = Astro.props;
const { isHome = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class={isHome ? "is-home" : "is-page"}>
    <BootIntro />

    <NavbarHome />

    <main class="page">
      <ContactMe />
      <slot />
      <footer></footer>
    </main>
    <script is:inline type="module">
      import "/src/scripts/app.js";
      import "/src/scripts/core/contactPanel.js";
    </script>
  </body>
</html>
