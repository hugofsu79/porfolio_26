---
import { projects } from "../data/projects";
---

<h1>Projets</h1>

<ul class="projects-list">
  {
    projects.map((project) => (
      <li>
        <a href={`/projects/${project.slug}`}>
          <h2>{project.hero.title}</h2>
          <p>{project.context}</p>
        </a>
      </li>
    ))
  }
</ul>
