---
import NavbarHome from "../components/layout/Navigation.astro";
import Title from "../components/sections/titleHome.astro";
---

<div class="header">
  <NavbarHome />

  <div class="rightPart">
    <Title />

    <ul class="marquee">
      <li>Designer UI/UX</li>
      <li>Intégrateur front</li>
      <li>Concepteur d'application</li>
      <li>Product Designer</li>
    </ul>

    <svg
      class="bg-rect"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect x="0" y="0" width="100%" height="50%"></rect>
    </svg>
  </div>
</div>

<script is:inline type="module">
  import { initMarquee } from "/src/scripts/marquee.js";

  window.addEventListener("DOMContentLoaded", () => {
    console.log("DOM READY");
    initMarquee();
  });
</script>
