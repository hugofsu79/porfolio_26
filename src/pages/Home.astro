---
import NavbarHome from "../components/layout/Navigation.astro";
import Title from "../components/sections/titleHome.astro";
import About from "../components/sections/About.astro";
---

<div class="header">
  <NavbarHome />

  <div class="rightPart">
    <div class="titleHome">
      <div class="titleText">
        <Title />
      </div>

      <ul class="marquee">
        <li>Designer UI/UX</li>
        <li>Intégrateur front</li>
        <li>Concepteur d'application</li>
        <li>Product Designer</li>
      </ul>
      <!-- <div class="coverProfil"></div> -->
    </div>
  </div>
</div>

<section id="about" class="about">
  <About />
</section>

<script>
  import { initLoopingRow } from "../scripts/marquee.js";

  // debug: tu dois voir ça dans la console
  console.log("HOME SCRIPT OK", {
    marquee: document.querySelector(".marquee"),
    allies: document.querySelector(".allies"),
  });

  initLoopingRow(".marquee", { speed: 0.6, slowSpeed: 0.05 });

  // on attend le prochain frame pour être 100% safe
  requestAnimationFrame(() => {
    initLoopingRow(".allies", { speed: 0.6, slowSpeed: 0.05 });
  });
</script>

