---
import { projects } from "../../data/projects";
import type { Project } from "../../types/project";
import Layout from "../../layouts/Layout.astro";
import NavbarHome from "../../components/layout/Navigation.astro";
import Carousel from "../../components/sections/Carousel.astro";
import Modale_follower from "../../components/ui/ModaleFollow.astro";

// 1) Génération des routes
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;

const project = projects.find((p): p is Project => p.slug === slug);

if (!project) {
  throw new Error(`Project not found for slug: ${slug}`);
}
---

<Layout title={project.slug}>
  <NavbarHome />

  <main class="project-page">
    <header class="project-hero">
      <img src={project.hero.cover} alt={project.slug} />
    </header>

    <Modale_follower />
    <section class="projetAll">
      <div class="headerProject">
        <div class="elementproject">
          <p>{project.hero.year}</p>
          <p>{project.hero.tags}</p>
        </div>
        <h2 class="project-title project-title--hero">{project.hero.title}</h2>
      </div>
      <div class="grid">
        <div class="leftCorridor">
          {
            project.sections?.context?.description && (
              <section class="context">
                <h3 class="project-title project-title--context">
                  {project.hero.title}
                </h3>
                <div>
                  <ul class="skill">
                    {project.leftCorridor.skills.value.map((skill) => {
                      const hue = Math.floor(Math.random() * 360);
                      return (
                        <li style={`--tag-color: hsl(${hue}, 70%, 50%)`}>
                          {skill}
                        </li>
                      );
                    })}
                  </ul>
                  <h4>Contexte</h4>
                  <hr />

                  <p>{project.sections.context.description}</p>
                </div>
                <table class="tableContexte">
                  <tbody>
                    {project.sections.context.details.map((item) => {
                      const values = Array.isArray(item.value)
                        ? item.value
                        : [item.value];

                      const isLinkObject = (v) =>
                        typeof v === "object" && "href" in v;

                      const displayNodes = values.map((v, index) =>
                        isLinkObject(v) ? (
                          <>
                            <a
                              href={v.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="external-link"
                            >
                              {v.label}
                            </a>
                            {index < values.length - 1 && " · "}
                          </>
                        ) : (
                          <>
                            {v}
                            {index < values.length - 1 && " · "}
                          </>
                        ),
                      );

                      const duration = 6 + values.length * 2;

                      return (
                        <tr>
                          <th scope="row">{item.label}</th>

                          <td class={item.marquee ? "marquee-cell" : ""}>
                            {item.marquee ? (
                              <div
                                class="table-marquee"
                                style={`--marquee-duration: ${duration}s`}
                              >
                                <div class="table-marquee__track">
                                  <span class="table-marquee__item">
                                    {displayNodes}
                                  </span>
                                  <span class="table-marquee__item">
                                    {displayNodes}
                                  </span>
                                </div>
                              </div>
                            ) : (
                              displayNodes
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </section>
            )
          }
        </div>

        <div class="rightCorridor">
          {
            project.sections?.objectifs?.description && (
              <div class="grid-mini">
                <div class="textGrid">
                  <h4>Objectifs</h4>
                  <hr />
                  <p>{project.sections.objectifs.description}</p>
                </div>

                {project.sections.objectifs.image && (
                  <img
                    class="objectifIllustration"
                    src={project.sections.objectifs.image}
                    alt="Section du design system"
                  />
                )}
              </div>
            )
          }
          <div class="carousel">
            <Carousel images={project.carousel.images} />
          </div>
          {
            project.sections?.role && (
              <div class="grid-mini">
                <img src={project.sections.role.image} alt="" />
                <div class="textGrid">
                  <h4>Mon rôle</h4>
                  <hr />
                  <p>{project.sections.role.description}</p>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </section>
    <script type="module">
      const heroTitle = document.querySelector(".project-title--hero");
      const contextTitle = document.querySelector(".project-title--context");
      const context = document.querySelector(".context");

      if (!heroTitle || !contextTitle || !context) {
        console.warn("Missing title elements");
      } else {
        const threshold =
          context.getBoundingClientRect().top + window.scrollY - 120;

        function onScroll() {
          if (window.scrollY >= threshold) {
            // Hero title disparaît doucement
            heroTitle.style.opacity = "0";
            heroTitle.style.pointerEvents = "none";

            // Context title apparaît progressivement
            contextTitle.style.maxHeight = "80px"; // assez pour un h3
            contextTitle.style.opacity = "1";
            contextTitle.style.transform = "translateY(0)";
          } else {
            // Hero title revient
            heroTitle.style.opacity = "1";
            heroTitle.style.pointerEvents = "auto";

            // Context title disparaît sans shape
            contextTitle.style.maxHeight = "0";
            contextTitle.style.opacity = "0";
            contextTitle.style.transform = "translateY(6px)";
          }
        }

        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </main>
</Layout>
