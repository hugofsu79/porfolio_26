---
import { projects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";
import NavbarHome from "../../components/layout/Navigation.astro";

// 1) Astro va générer une page par item retourné ici
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// 2) On récupère le projet correspondant à la page
const { project } = Astro.props;
---

<Layout title={project.slug}>
  <NavbarHome />

  <main class="project-page">
    <header class="project-hero">
      <img src={project.hero.image} alt={project.hero.title} loading="lazy" />
      <h1>{project.hero.title}</h1>
      <p>{project.hero.year}</p>
    </header>

    {/* Exemple : adapte selon ta structure exacte de data */}
    {
      project.sections?.context?.description && (
        <section>
          <h2>Contexte</h2>
          <p>{project.sections.context.description}</p>
        </section>
      )
    }

    {
      project.sections?.objectifs && (
        <section>
          <h2>Objectifs</h2>
          <p>{project.sections.objectifs}</p>
        </section>
      )
    }

    {
      project.sections?.role && (
        <section>
          <h2>Rôle</h2>
          <p>{project.sections.role}</p>
        </section>
      )
    }
  </main>
</Layout>
