---
const showIntro = true; // optionnel si tu veux conditionner plus tard
---

<style>
    #bootIntro {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        padding: 2rem;
    }
    .boot {
        position: fixed;
        inset: 0;
        background: var(--color-bg);
        z-index: 9999;

        padding: 40px;
        display: flex;
        align-items: center;

        font-family: "IBM Plex Mono", monospace;
        font-size: 15px;
        line-height: 1.6;
        color: --color-bg-secondary;

        transform-origin: center;
        clip-path: inset(0% 0% 0% 0%);
        transition: clip-path 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .boot.is-done {
        clip-path: inset(50% 0% 50% 0%);
        pointer-events: none;
    }
</style>

<section id="bootIntro" class="boot">
    <pre id="terminal"></pre>
</section>

<script src="/src/scripts/pages/bootIntro.ts" defer></script>
