---
type CarouselImage = { src: string; alt: string };
const { images } = Astro.props as { images: CarouselImage[] };
import ArrowTransition from "../ui/ArrowTransition.astro";
---

<div class="carouselAll" data-carousel data-direction="next">
  <div class="carousel__viewport">
    <ul class="carousel__track">
      {
        images.map((img, index) => (
          <li
            class={`carousel__slide ${index === 0 ? "is-active" : ""}`}
            data-index={index}
            aria-hidden={index !== 0}
          >
            <img src={img.src} alt={img.alt} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>

  <ArrowTransition />
</div>