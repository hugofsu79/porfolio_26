    <div class="context">
        <div class="titleRubrique">
            <h3>Recettes</h3>
            <hr />
        </div>
        <p>
            "L'alimentation est l'un des rares espaces où le multiculturalisme
            est vécu plutôt que dénattu."<br /><i
                >Chua Beng Huat | Sociologue, National University of Singapore</i
            >
        </p>
    </div>
</div> -->
<div class="rightColumn">
    <div class="miniSection">
        <div class="carouselRecipe">
            <div class="gridrSlide">
                {
                    mesRecettes.map((recette) => (
                        <article>
                            <button
                                class="mailSend"
                                type="button"
                                data-open-recipe
                                data-title={recette.title}
                                data-pdf={`/pdf/${recette.slug}.pdf`}
                                data-image={recette.cover}
                            >
                                <p>Recevoir la recette</p>

                                <img
                                    src="/public/icons/labo/send_recet.svg"
                                    alt={
                                        "M'envoyer la recette de " +
                                        recette.title
                                    }
                                />
                            </button>
                            <img src={recette.cover} alt={recette.title} />
                            <div class="recette">
                                <div class="frontInformation">
                                    <p>{recette.origin}</p>
                                    <p>
                                        Publiée le {recette.date.day}{" "}
                                        {recette.date.mouth},{" "}
                                        {recette.date.year}
                                    </p>
                                </div>
                                <details class="recipe">
                                    <summary class="recipeSummary">
                                        {recette.title}
                                    </summary>
                                    <h5>Ingrédients</h5>
                                    <ul>
                                        {recette.ingredients.map((ing) => {
                                            const ingredient =
                                                formatIngredient(ing);
                                            return (
                                                <>
                                                    <hr />
                                                    <li class="ingredientLine">
                                                        <span class="ingredientName">
                                                            {ingredient.name}
                                                        </span>
                                                        <span class="ingredientQty">
                                                            {
                                                                ingredient.quantity
                                                            }
                                                        </span>
                                                    </li>
                                                </>
                                            );
                                        })}
                                    </ul>
                                </details>
                            </div>
                        </article>
                    ))
                }
            </div>
            <ArrowTransition />
        </div>
    </div>
</div>
