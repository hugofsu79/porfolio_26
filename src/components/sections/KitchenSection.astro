---
import { mesRecettes } from "../../data/laboratoireElement"; // adapte juste CE chemin
import ModaleRecipe from "../ui/ModalRecipe.astro";

type Ingredient = {
    name: string;
    quantity?: number | string;
    unit?: string;
    note?: string;
};

function formatIngredient(ing: Ingredient) {
    let quantity = "";

    if (ing.quantity && ing.unit) {
        quantity = `${ing.quantity} ${ing.unit}`;
    } else if (ing.quantity) {
        quantity = `${ing.quantity}`;
    }

    return {
        name: ing.note ? `${ing.name} (${ing.note})` : ing.name,
        quantity,
    };
}
---

<ModaleRecipe />

<div class="leftColumn">
    <div class="context">
        <div class="titleRubrique">
            <h3>Recettes</h3>
            <hr />
        </div>
        <p>
            "L'alimentation est l'un des rares espaces où le multiculturalisme
            est vécu plutôt que dénattu."<br /><i
                >Chua Beng Huat | Sociologue, National University of Singapore</i
            >
        </p>
    </div>
</div>
<div class="rightColumn">
    <div class="miniSection">
        <div class="carouselRecipe">
            <div class="gridrSlide">
                {
                    mesRecettes.map((recette) => (
                        <article>
                            <button
                                class="mailSend"
                                type="button"
                                data-open-recipe
                                data-title={recette.title}
                                data-pdf={`/pdf/${recette.slug}.pdf`}
                                data-image={recette.cover}
                            >
                                <p>Recevoir la recette</p>

                                <img
                                    src="/public/icons/labo/send_recet.svg"
                                    alt={
                                        "M'envoyer la recette de " +
                                        recette.title
                                    }
                                />
                            </button>
                            <img src={recette.cover} alt={recette.title} />
                            <div class="recette">
                                <div class="frontInformation">
                                    <p>{recette.origin}</p>
                                    <p>
                                        Publiée le {recette.date.day}{" "}
                                        {recette.date.mouth},{" "}
                                        {recette.date.year}
                                    </p>
                                </div>
                                <details class="recipe">
                                    <summary class="recipeSummary">
                                        {recette.title}
                                    </summary>
                                    <h5>Ingrédients</h5>
                                    <ul>
                                        {recette.ingredients.map((ing) => {
                                            const ingredient =
                                                formatIngredient(ing);
                                            return (
                                                <>
                                                    <hr />
                                                    <li class="ingredientLine">
                                                        <span class="ingredientName">
                                                            {ingredient.name}
                                                        </span>
                                                        <span class="ingredientQty">
                                                            {
                                                                ingredient.quantity
                                                            }
                                                        </span>
                                                    </li>
                                                </>
                                            );
                                        })}
                                    </ul>
                                </details>
                            </div>
                        </article>
                    ))
                }
            </div>
            <div class="arrowMoove">
                <button
                    class="sliderArrow left"
                    aria-label="Recettes précédentes"
                >
                    <span class="arrowInner">
                        <svg
                            width="109"
                            height="15"
                            viewBox="0 0 109 15"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M0.292885 8.07088C-0.097641 7.68035 -0.097641 7.04719 0.292885 6.65666L6.65685 0.292702C7.04737 -0.0978227 7.68053 -0.0978227 8.07106 0.292702C8.46159 0.683226 8.46159 1.31639 8.07106 1.70692L2.41421 7.36377L8.07106 13.0206C8.46159 13.4111 8.46159 14.0443 8.07106 14.4348C7.68053 14.8254 7.04737 14.8254 6.65685 14.4348L0.292885 8.07088ZM109 7.36377V8.36377H0.999992V7.36377V6.36377H109V7.36377Z"
                                fill="#EAFFF7"></path>
                        </svg>
                    </span>
                </button>
                <button
                    class="sliderArrow right"
                    aria-label="Recettes suivantes"
                >
                    <span class="arrowInner">
                        <svg
                            width="109"
                            height="15"
                            viewBox="0 0 109 15"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M108.707 8.07088C109.098 7.68035 109.098 7.04719 108.707 6.65666L102.343 0.292702C101.953 -0.0978227 101.319 -0.0978227 100.929 0.292702C100.538 0.683226 100.538 1.31639 100.929 1.70692L106.586 7.36377L100.929 13.0206C100.538 13.4111 100.538 14.0443 100.929 14.4348C101.319 14.8254 101.953 14.8254 102.343 14.4348L108.707 8.07088ZM0 7.36377V8.36377H108V7.36377V6.36377H0V7.36377Z"
                                fill="#EAFFF7"></path>
                        </svg>
                    </span>
                </button>
            </div>
        </div>
    </div>

    <script lang="ts">
    </script>
    <script type="module" src="/src/scripts/recipeModal.ts"></script>
</div>
