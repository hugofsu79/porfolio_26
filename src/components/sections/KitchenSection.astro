---
import { mesRecettes } from "../../data/laboratoireElement"; // adapte juste CE chemin
import ModaleRecipe from "../ui/ModalRecipe.astro";
import ArrowTransition from "../ui/ArrowTransition.astro";

type Ingredient = {
    name: string;
    quantity?: number | string;
    unit?: string;
    note?: string;
};

function formatIngredient(ing: Ingredient) {
    let quantity = "";

    if (ing.quantity && ing.unit) {
        quantity = `${ing.quantity} ${ing.unit}`;
    } else if (ing.quantity) {
        quantity = `${ing.quantity}`;
    }

    return {
        name: ing.note ? `${ing.name} (${ing.note})` : ing.name,
        quantity,
    };
}
---

<ModaleRecipe />

