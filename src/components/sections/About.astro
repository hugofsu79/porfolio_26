---
import Icon from "../ui/Icon.astro";

const allies = [
  { name: "figma", label: "Figma" },
  { name: "ableton", label: "Ableton" },
  { name: "animejs", label: "Anime.js" },
  { name: "anytype", label: "Anytype" },
  { name: "github", label: "GitHub" },
  { name: "gsap", label: "GSAP" },
  { name: "illustrator", label: "Adobe Illustrator" },
  { name: "javascript", label: "JavaScript" },
  { name: "lottiefiles", label: "LottieFiles" },
  { name: "make", label: "Make" },
  { name: "motiondev", label: "Motion Dev" },
  { name: "notion", label: "Notion" },
  { name: "slack", label: "Slack" },
  { name: "tailwind", label: "Tailwind CSS" },
  { name: "useberry", label: "Useberry" },
  { name: "wordpress", label: "WordPress" },
  { name: "zeroheight", label: "Zeroheight" },
];
---

<div class="position">
  <img class="moulure" src="/icons/Hugo_point.svg" alt="" />
</div>
<div class="content">
  <h2>À propos</h2>
  <div class="aboutMe">
    <div class="col-l">
      <div class="AboutTitle">
        <div class="textPerso">
          <img src="/icons/about/iconeVie.svg" alt="Mes autres vies" />
          <h4>Mes autres vies</h4>
        </div>
        <table class="table">
          <tbody>
            <tr>
              <th scope="row">Agent de quai</th>
              <td>ELIS</td>
              <td>Chauray</td>
            </tr>
            <tr>
              <th scope="row">Logisticien</th>
              <td>SDIS</td>
              <td>Chauray</td>
            </tr>
            <tr>
              <th scope="row">Mise sous pli</th>
              <td>La Poste</td>
              <td>Labège</td>
            </tr>
            <tr>
              <th scope="row">Sound-designer</th>
              <td>Micro-entreprise</td>
              <td>Niort</td>
            </tr>
            <tr>
              <th scope="row">Vendeur</th>
              <td>Duty-free</td>
              <td>Blagnac</td>
            </tr>
            <tr>
              <th scope="row">Manutentionnaire</th>
              <td>Deya</td>
              <td>La Crèche</td>
            </tr>
            <tr>
              <th scope="row">Maçon</th>
              <td>Moreau Laurent</td>
              <td>Vallans</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="col-r">
      <div class="miniSectionFront">
        <div class="miniSection">
          <h4>Ma pomme</h4>
          <div class="textPerso">
            <p>
              Je suis un designer au profil hybride,<span class="muted">
                animé par une</span
              > curiosité insatiable. Passionné <span class="muted"
                >par de nombreux univers comme</span
              > la musique, la botanique, la cuisine ou le code, j’aime comprendre
              ce qui motive les gens, qu’ils soient clients, utilisateurs ou collaborateurs.
              <span class="muted"
                >Je m’intéresse aussi à des domaines qui sortent d’un</span
              > cursus classique, mais qui nourrissent ma pratique.
            </p>
            <p>
              La rhétorique<span class="muted"> m’aide à mieux saisir</span> la logique
              derrière les décisions et à affiner ma communication<span
                class="muted"
                >, tandis que le
              </span>développement<span class="muted">
                me permet de
              </span>comprendre le langage des développeurs,<span class="muted">
                mes principaux interlocuteurs, et de</span
              > concevoir des interfaces plus cohérentes avec leurs contraintes.
            </p>
          </div>
        </div>
        <div class="miniSection">
          <h4>Ce que je recherche</h4>
          <div class="textPerso">
            <p>
              Je souhaite travailler sur des produits exigeants,<span
                class="muted"
              >
                où la
              </span>conception d’interface<span class="muted">
                n’est pas un simple habillage,</span
              > mais un véritable levier de compréhension, d’usage et de cohérence
              produit.<span class="muted"> Mon profil hybride</span> UI/UX designer
              et développeur front-end<span class="muted">
                n’est pas un compromis mais plutôt
              </span> c’est un choix.
            </p>
            <p>
              <span class="muted">Il me permet de</span> concevoir des interfaces
              pensées jusqu’au détail, <span class="muted"
                >en lien direct avec leur</span
              > implémentation technique.<span class="muted">
                Je cherche des équipes qui accordent de</span
              >
              l’importance à la qualité, à la méthode et à la vision produit, et des
              projets <span class="muted"> complexes</span> pour continuer à progresser<span
                class="muted"
              >
                sans tomber dans l’exécution répétitive.</span
              >
            </p>
          </div>
        </div>
      </div>
      <div class="miniSection">
        <h4>mes alliés</h4>
        <div class="allies-wrap">
          <ul class="allies">
            {
              allies.map((a) => (
                <li class="icons" data-label={a.label}>
                  <Icon name={a.name} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="miniSection">
        <h4>Mes passions</h4>
        <ul class="listPassions">
          <li>L'agrumiculture</li>
          <li>Muscu</li>
          <li>Cuisine</li>
          <li>Concert</li>
          <li>Musée</li>
          <li>Théâtre</li>
          <li>Composer</li>
          <li>Synthétiseur</li>
          <li>Documentaire</li>
          <li>Jardinage</li>
          <li>Technologie</li>
          <li>Canvas</li>
          <li>Écologie</li>
          <li>IDM</li>
          <li>Figma</li>
          <li>Déco</li>
        </ul>
      </div>
    </div>
  </div>
</div>
<img class="moulure" src="/icons/Foisseau_point.svg" alt="" />
