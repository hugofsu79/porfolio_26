---
export interface Props {
  label: string;
  href?: string;
  target?: "_blank" | "_self";
  alt?: string;
  type?: "button" | "submit" | "reset";
}

const {
  label,
  href,
  target = "_self",
  alt = "",
  type = "button",
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={target === "_blank" ? "noopener noreferrer" : undefined}
    >
      <span class="ctaLabelLink">{label}</span>
    </a>
  ) : (
    <button class="cta" type={type}>
      <span class="ctaLabel">{label}</span>
    </button>
  )
}
