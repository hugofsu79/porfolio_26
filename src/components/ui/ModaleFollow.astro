---
const currentPath = Astro.url.pathname;
---

<div class="modaleFollower">
    <ul>
        <li
            class={currentPath.includes("/projects/siko-mobility")
                ? "is-active"
                : ""}
        >
            <a href="/projects/siko-mobility">Siko Mobility</a>
        </li>
        <hr />

        <li
            class={currentPath.includes("/projects/rhizome") ? "is-active" : ""}
        >
            <a href="/projects/rhizome">Rhizome</a>
        </li>
        <hr />

        <li class={currentPath.includes("/projects/kiro") ? "is-active" : ""}>
            <a href="/projects/kiro">Kiro</a>
        </li>
        <hr />

        <li class={currentPath.includes("/projects/oneiro") ? "is-active" : ""}>
            <a href="/projects/oneiro">Oneiro</a>
        </li>
    </ul>
</div>
